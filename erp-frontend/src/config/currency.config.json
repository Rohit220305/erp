{
  "moduleName": "Currency",
  "title": "Currencies",

  "permissions": {
    "list":   "CURRENCY_LIST",
    "create": "CURRENCY_CREATE",
    "view":   "CURRENCY_VIEW",
    "update": "CURRENCY_UPDATE",
    "delete": "CURRENCY_DELETE"
  },

  "actions": {
    "viewRedirectPath": "/currency/{id}",
    "header": [
      {
        "label": "Add Currency",
        "type": "redirect",
        "path": "/currency/add",
        "permission": "CURRENCY_CREATE"
      }
    ],
    "row": [
      {
        "label": "Edit",
        "type": "editRedirect",
        "path": "/currency/edit/{id}",
        "icon": "Edit",
        "permission": "CURRENCY_UPDATE"
      },
      {
        "label": "Delete",
        "type": "deleteModal",
        "icon": "Trash2",
        "permission": "CURRENCY_DELETE",
        "danger": true
      },
      {
        "label": "View Details",
        "type": "viewDrawer"
      }
    ]
  },

  "defaultFilters": {
    "currencyCode": "",
    "currencyName": "",
    "currencySymbol": "",
    "status": ""
  },

  "sidebarStatuses": [
    { "label": "Active", "value": "Active" },
    { "label": "InActive", "value": "InActive" }
  ],

  "searchFields": [
    { "label": "Currency Code",   "value": "currencyCode",   "type": "text" },
    { "label": "Currency Name",   "value": "currencyName",   "type": "text" },
    { "label": "Currency Symbol", "value": "currencySymbol", "type": "text" },
    {
      "label": "Status",
      "value": "status",
      "type": "select",
      "options": [
        { "label": "Active",   "value": "Active" },
        { "label": "InActive", "value": "InActive" }
      ]
    }
  ],

  "columns": [
    { "label": "Name",   "key": "currencyName",   "type": "link",       "linkPath": "/currency/{id}", "searchable": true,  "sortable": true  },
    { "label": "Code",   "key": "currencyCode",   "type": "text",       "searchable": true,  "sortable": true  },
    { "label": "Symbol", "key": "currencySymbol", "type": "text",       "searchable": false, "sortable": false },
    {
      "label": "Status",
      "key": "status",
      "type": "statusBadge",
      "searchable": true,
      "sortable": true,
      "options": [
        { "label": "Active",   "value": "Active" },
        { "label": "InActive", "value": "InActive" }
      ]
    }
  ],

  "viewFields": [
    { "key": "currencyCode",   "label": "Currency Code",   "type": "text" },
    { "key": "currencyName",   "label": "Currency Name",   "type": "text" },
    { "key": "currencySymbol", "label": "Currency Symbol", "type": "text" },
    { "key": "status",         "label": "Status",          "type": "statusBadge" }
  ],

  "listCard": {
    "primary": {
      "title":    "currencyName",
      "subtitle": "currencyCode"
    },
    "columns": [
      { "label": "Symbol", "key": "currencySymbol", "type": "text"       },
      { "label": "Status", "key": "status",         "type": "statusBadge" }
    ],
    "expanded": []
  },

  "gridCard": {
    "header": {
      "title":    "currencyName",
      "subtitle": "currencyCode",
      "badge":    "status"
    },
    "details": [
      { "label": "Symbol", "key": "currencySymbol", "type": "text" }
    ],
    "footer": {}
  }
}
