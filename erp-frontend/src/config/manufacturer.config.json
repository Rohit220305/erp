      "value": "manufacturerName",
      "type": "text"
    },
    {
      "label": "Manufacturer Code",
      "value": "manufacturerCode",
      "type": "text"
    },
    {
      "label": "Status",
      "value": "status",
      "type": "select",
      "options": [
        {
          "label": "Active",
          "value": "Active"
        },
        {
          "label": "Inactive",
          "value": "Inactive"
        }
      ]
    }
  ],
  "searchFields": [
    {
