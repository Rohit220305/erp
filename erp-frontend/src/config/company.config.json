{
  "moduleName": "Company",
  "title": "Company Master",
  "permissions": {
    "list": "COMPANY_LIST",
    "create": "COMPANY_CREATE",
    "view": "COMPANY_VIEW",
    "update": "COMPANY_UPDATE",
    "delete": "COMPANY_DELETE"
  },
  "columns": [
    { "label": "Logo", "key": "logoUrl", "type": "image", "searchable": false, "sortable": false },
    { "label": "Company Name", "key": "companyName", "type": "link", "linkPath": "/company/{id}", "searchable": true, "sortable": false },
    { "label": "Short Name", "key": "shortName", "type": "text", "searchable": true, "sortable": false },
    { "label": "Company Code", "key": "companyCode", "type": "text", "searchable": true, "sortable": false },
    { "label": "Contact Person", "key": "contactPersonName", "type": "text", "searchable": true, "sortable": false },
    { "label": "Email", "key": "email", "type": "text", "searchable": true, "sortable": false },
    { "label": "Phone", "key": "phone", "type": "phone", "searchable": true, "sortable": false },
    { "label": "Status", "key": "status", "type": "statusBadge", "searchable": true, "sortable": false, "options": [{ "label": "Active", "value": "Active" }, { "label": "Inactive", "value": "InActive" }] },
    { "label": "Added Date", "key": "addedDateFormatted", "type": "text", "searchable": false, "sortable": false }
  ],
  "actions": {
    "header": [
      { "label": "Add Company", "type": "redirect", "path": "/company/add", "permission": "COMPANY_CREATE" }
    ],
    "row": [
      { "label": "Edit", "type": "editRedirect", "path": "/company/{id}/edit-company", "icon": "Edit", "permission": "COMPANY_UPDATE" },
      { "label": "View", "type": "viewRedirect", "path": "/company/{id}", "icon": "Eye", "permission": "COMPANY_VIEW" },
      { "label": "Delete", "type": "deleteModal", "icon": "Trash2", "permission": "COMPANY_DELETE", "danger": true }
    ]
  },
  "searchFields": [
    { "label": "Company Name", "value": "companyName", "type": "text" },
    { "label": "Short Name", "value": "shortName", "type": "text" },
    { "label": "Company Code", "value": "companyCode", "type": "text" },
    { "label": "Company Email", "value": "email", "type": "text" },
    { "label": "Company Phone", "value": "phone", "type": "text" },
    { "label": "Contact Person", "value": "contactPersonName", "type": "text" },
    {
      "label": "Status",
      "value": "status",
      "type": "select",
      "options": [
        { "label": "Active", "value": "Active" },
        { "label": "Inactive", "value": "Inactive" }
      ]
    }
  ],
  "defaultFilters": {
    "companyName": "",
    "shortName": "",
    "companyCode": "",
    "email": "",
    "phone": "",
    "contactPersonName": "",
    "status": ""
  },
  "sidebarStatuses": [
    { "label": "Active", "value": "Active" },
    { "label": "Inactive", "value": "Inactive" }
  ],
  "listCard": {
    "primary": {
      "image": "logoUrl",
      "title": "companyName",
      "subtitle": "companyCode"
    },
    "columns": [
      { "label": "Email", "key": "email", "type": "text" },
      { "label": "Phone", "key": "phone", "type": "phone" },
      { "label": "Status", "key": "status", "type": "statusBadge" }
    ],
    "expanded": [
      { "label": "Legal Name", "key": "legalName", "type": "text" },
      { "label": "Registration No.", "key": "registrationNumber", "type": "text" },
      { "label": "Contact Person", "key": "contactPersonName", "type": "text" },
      { "label": "Added Date", "key": "addedDateFormatted", "type": "text" }
    ]
  },
  "gridCard": {
    "header": {
      "image": "logoUrl",
      "title": "companyName",
      "subtitle": "shortName",
      "badge": "status"
    },
    "details": [
      { "icon": "Mail", "key": "email", "type": "text" },
      { "icon": "Phone", "key": "phone", "type": "phone" }
    ],
    "footer": {
      "date": "addedDateFormatted"
    }
  }
}

   