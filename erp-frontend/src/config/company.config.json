{
  "moduleName": "Company",
  "title": "Company Master",
  "permissions": {
    "list": "COMPANY_LIST",
    "create": "COMPANY_CREATE",
    "view": "COMPANY_VIEW",
    "update": "COMPANY_UPDATE",
    "delete": "COMPANY_DELETE"
  },
  "columns": [
    {
      "label": "Logo",
      "key": "logoUrl",
      "type": "image",
      "searchable": false,
      "sortable": false,
      "width": "80px"
    },
    {
      "label": "Company Name",
      "key": "companyName",
      "type": "link",
      "linkPath": "/company/{id}",
      "searchable": true,
      "sortable": true,
      "width": "220px"
    },
    {
      "label": "Short Name",
      "key": "shortName",
      "type": "text",
      "searchable": true,
      "sortable": true,
      "width": "120px"
    },
    {
      "label": "Company Code",
      "key": "companyCode",
      "type": "text",
      "searchable": true,
      "sortable": true,
      "width": "130px"
    },
    {
      "label": "Contact Person",
      "key": "contactPersonName",
      "type": "text",
      "searchable": true,
      "sortable": true,
      "width": "160px"
    },
    {
      "label": "Email",
      "key": "email",
      "type": "text",
      "searchable": true,
      "sortable": true,
      "width": "220px"
    },
    {
      "label": "Phone",
      "key": "phone",
      "type": "phone",
      "searchable": true,
      "sortable": true,
      "width": "150px"
    },
    {
      "label": "Added Date",
      "key": "addedDateFormatted",
      "type": "text",
      "searchable": false,
      "sortable": true,
      "width": "180px"
    },
    {
      "label": "Status",
      "key": "status",
      "type": "statusBadge",
      "searchable": true,
      "sortable": true,
      "width": "110px",
      "options": [
        {
          "label": "Active",
          "value": "Active"
        },
        {
          "label": "Inactive",
          "value": "Inactive"
        }
      ]
    }
  ],
  "actions": {
    "viewRedirectPath": "/company/{id}",
    "header": [
      {
        "label": "Add Company",
        "type": "redirect",
        "path": "/company/add",
        "permission": "COMPANY_CREATE"
      }
    ],
    "row": [
      {
        "label": "Edit",
        "type": "editRedirect",
        "path": "/company/{id}/edit-company",
        "icon": "Edit",
        "permission": "COMPANY_UPDATE"
      },
      {
        "label": "View",
        "type": "viewRedirect",
        "path": "/company/{id}",
        "icon": "Eye",
        "permission": "COMPANY_VIEW"
      },
      {
        "label": "Delete",
        "type": "deleteModal",
        "icon": "Trash2",
        "permission": "COMPANY_DELETE",
        "danger": true
      },
      {
        "label": "View Details",
        "type": "viewDrawer"
      }
    ]
  },
  "sidebarFields": [
    {
      "label": "Company Name",
      "value": "companyName",
      "type": "text"
    },
    {
      "label": "Short Name",
      "value": "shortName",
      "type": "text"
    },
    {
      "label": "Company Code",
      "value": "companyCode",
      "type": "text"
    },
    {
      "label": "Email",
      "value": "email",
      "type": "text"
    },
    {
      "label": "Phone",
      "value": "phone",
      "type": "text"
    },
    {
      "label": "Contact Person",
      "value": "contactPersonName",
      "type": "text"
    },
    {
      "label": "Status",
      "value": "status",
      "type": "select",
      "options": [
        {
          "label": "Active",
          "value": "Active"
        },
        {
          "label": "Inactive",
          "value": "Inactive"
        }
      ],
      "isMuqltiSelect": true
    }
  ],
  "searchFields": [
    {
      "label": "Company Name",
